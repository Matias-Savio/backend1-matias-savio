<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrito</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Carrito de Compras</h1>
    {{#if cart.products.length}}
    <div class="cart-products">
        {{#each cart.products}}
        <div class="cart-item">
            <h3>{{this.product.title}}</h3>
            <p>{{this.product.description}}</p>
            <p>Precio: ${{this.product.price}}</p>
            <p>Cantidad: {{this.quantity}}</p>
            <p>Total: ${{multiply this.product.price this.quantity}}</p>
            <button onclick="updateQuantity('{{../cart._id}}', '{{this.product._id}}', {{this.quantity}})">Actualizar Cantidad</button>
            <button onclick="removeFromCart('{{../cart._id}}', '{{this.product._id}}')">Eliminar</button>
        </div>
        {{/each}}
    </div>
    <button onclick="clearCart('{{cart._id}}')">Vaciar Carrito</button>
    {{else}}
    <p>El carrito está vacío</p>
    {{/if}}
    <a href="/products">Continuar Comprando</a>

    <script>
        async function updateQuantity(cartId, productId, currentQty) {
            const newQty = prompt('Nueva cantidad:', currentQty);
            if (!newQty || newQty < 1) return;

            try {
                const response = await fetch(`/api/carts/${cartId}/products/${productId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ quantity: parseInt(newQty) })
                });

                if (response.ok) {
                    location.reload();
                } else {
                    alert('Error al actualizar cantidad');
                }
            } catch (error) {
                console.error('Error:', error);
            }
        }

        async function removeFromCart(cartId, productId) {
            try {
                const response = await fetch(`/api/carts/${cartId}/products/${productId}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    location.reload();
                } else {
                    alert('Error al eliminar producto');
                }
            } catch (error) {
                console.error('Error:', error);
            }
        }

        async function clearCart(cartId) {
            try {
                const response = await fetch(`/api/carts/${cartId}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    location.reload();
                } else {
                    alert('Error al vaciar carrito');
                }
            } catch (error) {
                console.error('Error:', error);
            }
        }
    </script>
</body>
</html>